RIFF_PROJECT_ID=your-gcp-project-id
RIFF_LOCATION=us-central1
# Gemini 3.x is served only by the "global" Vertex endpoint.
RIFF_VERTEX_LOCATION=global

RIFF_REASONING_MODEL=gemini-3.5-flash
RIFF_EMBEDDING_MODEL=gemini-embedding-001
RIFF_EMBEDDING_DIMENSIONS=768

RIFF_FIRESTORE_DATABASE=(default)
RIFF_PDF_BUCKET=your-project-riff-pdfs

RIFF_ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1
RIFF_ALPHAXIV_API_KEY=

RIFF_PRESENCE_THRESHOLD=0.62
RIFF_MAX_ASSESSMENTS_PER_SECTION=3
RIFF_DEFENCE_INTERVAL=10
